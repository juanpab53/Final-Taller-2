generator client {
  provider     = "prisma-client-js"
  engineType   = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum role {
  CLIENT
  ADMIN
}

enum cart_state {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum order_state {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum payment_status {
  PENDING
  PAID
  CANCELLED
}

// ─── Modelos ───────────────────────────────────────────

model user{
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  email         String   @db.VarChar(80) @unique
  tel           String   @db.VarChar(50)
  role          role     @default(CLIENT)
  password_hash String   @db.VarChar(60)
  carts     cart[]
  orders order[]
}

model cart {
  id        String     @id @default(uuid()) @db.Uuid
  user_id   String     @db.Uuid
  user      user      @relation(fields: [user_id], references: [id])
  state     cart_state  @default(ACTIVE)
  expired_at DateTime?   @db.Timestamp
  cartItems cartItem[]

  @@index([user_id])
}

model cartItem {
  id        String     @id @default(uuid()) @db.Uuid
  quantity  Int        @db.Integer
  unit_price Float
  cart_id   String     @db.Uuid
  cart      cart       @relation(fields: [cart_id], references: [id])
  book_id   String     @db.Uuid
  book      book       @relation(fields: [book_id], references: [id])
}

model order{
  id          String   @id @default(uuid()) @db.Uuid
  state       order_state @default(PENDING)
  direction   String   @db.Text 
  created_at  DateTime @default(now()) @db.Timestamp
  total       Float 
  user_id     String   @db.Uuid
  user        user @relation(fields: [user_id], references: [id])
  pay         pay?
  order_details order_detail[]
}

model pay{
  id                          String        @id @default(uuid()) @db.Uuid
  amount                      Decimal       @db.Decimal(10, 2) 
  receipt                     String        
  status                      payment_status @default(PENDING)
  issuedAt                    DateTime      @default(now())    
  paidAt                      DateTime?    
  orderId                     String        @unique @db.Uuid
  order                       order         @relation(fields: [orderId], references: [id])
  stripe_checkout_session_id  String?       @unique @db.VarChar(255)
  stripe_payment_intent_id    String?       @unique @db.VarChar(255)
  currency                    String        @default("usd") @db.VarChar(3)
}

model order_detail{
  id          String   @id @default(uuid()) @db.Uuid
  quantity    Int      @db.Integer
  unit_price  Float
  book_id     String   @db.Uuid
  book        book     @relation(fields: [book_id], references: [id])
  order_id    String   @db.Uuid
  order       order    @relation(fields: [order_id], references: [id])
}

model book{
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  price             Float
  stock             Int      @db.Integer
  image_url         String?  @db.VarChar(500)
  publication_date  DateTime @db.Date
  description       String?  @db.Text
  language          String   @db.VarChar(50)
  order_details     order_detail[]
  cartItems         cartItem[]
  author_id         String   @db.Uuid
  author            author   @relation(fields: [author_id], references: [id])
  category_id       String   @db.Uuid
  category          category @relation(fields: [category_id], references: [id])

  @@index([name])
}

model author{
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  books         book[]

  @@index([name])
}

model category{
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  books         book[]

  @@index([name])
}

model stripe_event{
  id              String    @id @default(uuid()) @db.Uuid
  stripe_event_id String    @unique @db.VarChar(255)
  type            String    @db.VarChar(100)
  created_at      DateTime  @default(now()) @db.Timestamp
  processed_at    DateTime? @db.Timestamp
}